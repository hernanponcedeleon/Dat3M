let fr = rf^-1;co | ([R \ range(rf)]);loc;[W]

let po-loc = po & loc
let rmw = amo | lxsx

let rfe = rf & ext
let coe = co & ext
let fre = fr & ext
let rfi = rf & int
let coi = co & int
let fri = fr & int

let fencerel(F) = po;[F];po

// Enforce that reads from uninitialized memory are impossible if an init write exists.
empty ([R \ range(rf)]);loc;[IW] as force-init-read

let pick-addr = [M]; (__idd | __ctrlDirect)*; __addrDirect; [M]
let pick-ctrl = [M]; (__idd | __ctrlDirect)*; __ctrlDirect; [_]
let pick-data = [M]; (__idd | __ctrlDirect)*; __idd; [W]

flag ~empty [UB] as undefined-behavior