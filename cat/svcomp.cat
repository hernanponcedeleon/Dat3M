SVCOMP

(* All communication relations *)
let com = (rf | fr | co)

(* Sequential consistency *)
acyclic po | (com & int) | (rmw^-1? ; (com & ext))

(* Data Races *)
let Atomic = RMW | A
let sw = [Atomic]; rmw^-1? ;(com & ext); [Atomic]
let hb = (po | sw)+
let conflict = (ext & ((W * _) | (_ * W)) & loc) \ ((IW * _) | (_ * IW))
let dr = conflict \ (hb | hb^-1 | (Atomic * Atomic))

flag ~empty dr as data-race