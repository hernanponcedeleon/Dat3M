{}

P0(atomic_int *x, atomic_int *y, spinlock_t *s1)
{
	int r0;
    atomic_inc(x);
	spin_lock(s1);
	r0 = atomic_read(y);
	spin_unlock(s1);
}

P1(atomic_int *x, atomic_int *y, spinlock_t *s1)
{
	int r0;
    atomic_inc(y);
	spin_lock(s1);
    r0 = atomic_read(x);
    spin_unlock(s1);
}

forall (0:r0=1 \/ 1:r0=1)
