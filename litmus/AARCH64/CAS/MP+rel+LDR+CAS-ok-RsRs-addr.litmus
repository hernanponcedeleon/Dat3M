AArch64 MP+rel+LDR+CAS-ok-RsRs-addr
"CAS's result is dependent of either expected or actual value."
{
  0: X0 = x;      1: X0 = x;
  0: X1 = y;      1: X1 = y;
}

P0            | P1                     ;
MOV W2, #1    | LDR W2, [X1]           ;
STR W2, [X0]  | MOV W3, W2             ;
STLR W2, [X1] | MOV W4, #1             ;
              | CAS W3, W4, [X1]       ;
              | EOR W5, W3, W3         ;
              | LDR W6, [X0, W5, SXTW] ;

exists (1:X2 = 1 /\ 1:X3 = 1 /\ 1:X6 = 0)
