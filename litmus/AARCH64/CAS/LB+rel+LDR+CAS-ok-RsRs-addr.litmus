AArch64 LB+rel+LDR+CAS-ok-RsRs-addr
"CAS's result is dependent of either expected or actual value."
{
  0: X0 = x;      1: X0 = x;
  0: X1 = y;      1: X1 = y;
}

P0            | P1                     ;
LDR W2, [X0]  | LDR W2, [X1]           ;
MOV W3, #1    | MOV W3, W2             ;
STLR W3, [X1] | MOV W4, #1             ;
              | CAS W3, W4, [X1]       ;
              | EOR W5, W3, W3         ;
              | STR W4, [X0, W5, SXTW] ;

exists (1: X2 = 1 /\ 1: X3 = 1 /\ 0: X2 = 1)
