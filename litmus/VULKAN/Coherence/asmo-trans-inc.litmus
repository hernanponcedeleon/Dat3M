Vulkan
{
  v0=0;
  v1=0;
  o0=0;
  o1=0;
}
P0@sg 0, wg 0, qf 0  | P1@sg 1, wg 0, qf 0             | P2@sg 0, wg 1, qf 0              ;
st.atom.wg.sc0 v0, 1 | ld.atom.wg.sc0 r0, v0           | ld.atom.acq.qf.sc0.semsc0 r1, v1 ;
                     | st.atom.qf.sc0 v0, 2            | st.atom.qf.sc0 v0, 3             ;
                     | st.atom.rel.qf.sc0.semsc0 v1, 1 | st.sc0 o1, r1                    ;
                     | st.sc0 o0, r0                   |                                  ;

filter o0 == 1 /\ o1 == 1
exists o0 == 1 /\ o1 == 1
