VULKAN
{}
 P0@sg 0, wg 0, qf 0                  | P1@sg 0, wg 1, qf 0                    ;
 st.nonpriv.sc0 a, 1                  | ld.atom.acq.qf.sc0.semsc0.semvis r0, b ;
