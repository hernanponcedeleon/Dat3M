VULKAN
{}
 P0@sg 0, wg 0, qf 0         | P1@sg 0, wg 1, qf 0         ;
 membar.rel.qf.semsc0.semsc1 | ld.atom.qf.sc1 r0, b        ;
 st.atom.qf.sc0 a, 1         | membar.acq.qf.semsc1        ;
 membar.rel.qf.semsc1        | ld.atom.qf.sc0 r1, a        ;
 st.atom.qf.sc1 b, 1         | membar.acq.qf.semsc0.semsc1 ;

filter (P1:r0 == 1)
exists (P1:r0 == 1 /\ P1:r1 == 0)
