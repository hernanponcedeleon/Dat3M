VULKAN
{}
 P0@sg 0, wg 0, qf 0        | P1@sg 1, wg 0, qf 0             | P2@sg 0, wg 1, qf 0             ;
 st.nonpriv.sc0 a, 1        | ld.atom.acq.wg.sc0.semsc0 r0, b | ld.atom.acq.qf.sc0.semsc0 r0, c ;
 membar.rel.wg.semsc0.semav | membar.rel.qf.semsc0.semav      | ld.vis.qf.sc0 r1, a             ;
