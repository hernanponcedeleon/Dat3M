VULKAN
{}
 P0@sg 0, wg 0, qf 0                   | P1@sg 0, wg 1, qf 0                    ;
 st.av.qf.sc1 a, 1                     | ld.atom.acq.qf.sc0.semsc0.semsc1 r0, b ;
 st.atom.rel.qf.sc0.semsc0.semsc1 b, 1 | ld.vis.qf.sc1 r1, a                    ;

filter (P1:r0 == 1)
exists (P1:r0 == 1 /\ P1:r1 == 0)
