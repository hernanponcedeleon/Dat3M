VULKAN
{}
 P0@sg 0, wg 0, qf 0                  | P1@sg 1, wg 0, qf 0             | P2@sg 0, wg 1, qf 0             ;
 st.nonpriv.sc0 a, 1                  | ld.atom.acq.wg.sc0.semsc0 r0, b | ld.atom.acq.qf.sc0.semsc0 r0, b ;
 st.atom.rel.wg.sc0.semsc0.semav b, 1 | st.atom.rel.qf.sc0.semsc0 b, 2  | ld.vis.qf.sc0 r1, a             ;

filter (P1:r0 == 1 /\ P2:r0 == 2)
exists (P1:r0 == 1 /\ P2:r0 == 2 /\ P2:r1 == 0)
