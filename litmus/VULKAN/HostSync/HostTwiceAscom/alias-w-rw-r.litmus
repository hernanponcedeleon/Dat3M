VULKAN
{
b=0;
a aliases b;
}
{
ssw 0 1;
ssw 1 2;
ssw 3 4;
ssw 4 5;
}
 P0@sg 0, wg 0, qf 0 | P1@sg 0, wg 0, qf 1 | P2@sg 0, wg 0, qf 2  | P3@sg 0, wg 0, qf 3 | P4@sg 0, wg 0, qf 4 | P5@sg 0, wg 0, qf 5 ;
 st.sc0 a, 1         | avdevice            | ld.atom.dv.sc1 r0, b | st.atom.dv.sc1 b, 2 | avdevice            | ld.sc0 r0, a        ;
                     | visdevice           |                      |                     | visdevice           |                     ;

filter (P2:r0 == 1)
exists (P2:r0 == 1 /\ P5:r0 != 2)
