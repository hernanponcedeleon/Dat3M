VULKAN
{}
{
ssw 0 1;
}
 P0@sg 0, wg 0, qf 0 | P1@sg 0, wg 0, qf 1            | P2@sg 0, wg 0, qf 2             ;
 ld.sc0 r0, x        | st.atom.rel.dv.sc0.semsc0 y, 1 | ld.atom.acq.dv.sc0.semsc0 r0, y ;
                     |                                | bne r0, 1, LC20                 ;
                     |                                | ld.sc0 r1, x                    ;
                     |                                | LC20:                           ;

exists (P0:r0 != 0 \/ P2:r1 != 0)
