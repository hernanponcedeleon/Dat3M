VULKAN
{}
{
ssw 1 2;
}
 P0@sg 0, wg 0, qf 0            | P1@sg 0, wg 0, qf 1             | P2@sg 0, wg 0, qf 2 ;
 ld.sc0 r0, x                   | ld.atom.acq.dv.sc0.semsc0 r0, y | st.sc0 x, 1         ;
 bne r0, 0, LC00                |                                 |                     ;
 st.atom.rel.dv.sc0.semsc0 y, 1 |                                 |                     ;
 LC00:                          |                                 |                     ;

exists (P0:r0 == 1)
