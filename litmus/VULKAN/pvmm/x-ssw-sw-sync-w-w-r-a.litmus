VULKAN
{}
{
ssw 1 2;
}
 P0@sg 0, wg 0, qf 0            | P1@sg 1, wg 0, qf 0             | P2@sg 0, wg 0, qf 1 ;
 st.av.wg.sc0 x, 1              | ld.atom.acq.wg.sc0.semsc0 r0, y | ld.sc0 r0, x        ;
 st.atom.rel.wg.sc0.semsc0 y, 1 | st.av.wg.sc0 x, 2               |                     ;

filter
(P1:r0 == 1)
exists
(P1:r0 == 1 /\ P2:r0 != 2)