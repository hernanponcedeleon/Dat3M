Vulkan
{}
 P0@sg 0, wg 0, qf 0                         | P1@sg 1, wg 0, qf 0                         | P2@sg 0, wg 1, qf 0             ;
 st.nonpriv.sc0 a, 1                         | ld.atom.acq.wg.sc1.semsc1 r0, b             | ld.atom.acq.qf.sc0.semsc0 r0, c ;
 st.atom.rel.wg.sc1.semsc0.semsc1.semav b, 1 | st.atom.rel.qf.sc0.semsc0.semsc1.semav c, 1 | ld.vis.qf.sc0 r1, a             ;

filter
