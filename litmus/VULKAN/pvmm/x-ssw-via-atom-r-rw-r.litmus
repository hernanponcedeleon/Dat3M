ssw 2 3;
ssw 3 4;
}
 P0@sg 0, wg 0, qf 0 | P1@sg 0, wg 0, qf 2  | P2@sg 1, wg 0, qf 2 | P3@sg 0, wg 0, qf 3 | P4@sg 0, wg 0, qf 4 ;
 ld.sc0 r0, a        | ld.atom.wg.sc0 r0, a | st.atom.wg.sc0 a, 1 | avdevice            | ld.sc0 r0, a        ;
                     |                      |                     | visdevice           |                     ;

