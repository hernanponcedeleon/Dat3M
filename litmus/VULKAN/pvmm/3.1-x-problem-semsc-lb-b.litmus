Vulkan
{}
 P0@sg 0, wg 0, qf 0                    | P1@sg 0, wg 1, qf 0                    ;
 ld.atom.acq.qf.sc1.semsc0.semsc1 r0, x | ld.atom.acq.qf.sc2.semsc0.semsc2 r1, y ;
 st.atom.rel.qf.sc2.semsc0.semsc2 y, 1  | st.atom.rel.qf.sc1.semsc0.semsc1 x, 1  ;
filter
(P0:r0 == 1)
exists
(P0:r0 == 1 /\ P1:r1 == 1)